{
  "name": "Noisetupi Video Content Tool Web",
  "version": "0.7.1",
  "rendererFix": "nonblocking-missing-video",
  "playbackFix": "stable-video-frame-cache",
  "selectionModel": "unified-sticky-layer-selection",
  "fontBundle": "local-latin-woff2",
  "features": [
    "video-clip-duration",
    "video-clip-drag",
    "audio-input",
    "linked-audio-timeline",
    "timeline-layer-reorder",
    "track-fades",
    "locked-transform-axes",
    "section-copy-paste",
    "audio-effects",
    "gaussian-blur",
    "video-thumbnails",
    "audio-waveform",
    "social-composition-presets",
    "editable-composition-size",
    "unified-layer-clips",
    "timeline-fade-handles",
    "timeline-snap",
    "canvas-alignment-snap",
    "linked-av-order",
    "independent-track-heights",
    "centered-composition-resize",
    "editable-composition-background",
    "lightweight-media-references",
    "missing-media-relink",
    "replace-media",
    "zoom-correct-timeline-drag",
    "centered-audio-waveform",
    "canvas-transform-box",
    "text-box-layout",
    "square-default-geometry",
    "stable-video-playback",
    "unified-layer-selection",
    "optimized-local-fonts"
  ]
}
