{
  "name": "noisetupi-video-content-tool-web",
  "private": true,
  "version": "0.7.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tests.json",
    "build": "npm run typecheck && vite build && node scripts/copy-licenses.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:parity": "playwright test",
    "verify:legacy": "node scripts/verify-legacy.mjs",
    "check": "npm run verify:legacy && npm run test && npm run build && npm run test:parity",
    "package:hostinger": "npm run build && node scripts/package-hostinger.mjs && npm run verify:release",
    "verify:release": "node scripts/verify-release.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@fontsource/space-grotesk": "5.3.0",
    "@fontsource/syne": "5.3.0",
    "fflate": "0.8.3",
    "mediabunny": "1.52.3"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "24.10.0",
    "@types/pngjs": "6.0.5",
    "pngjs": "7.0.0",
    "prettier": "3.3.3",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "3.2.4"
  },
  "license": "MPL-2.0",
  "engines": {
    "node": ">=22.12.0"
  }
}
